# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-publishable-key

# EmailJS (confirmación de citas)
# Service ID: Email Services -> tu servicio -> Service ID
# Template ID: Email Templates -> tu plantilla -> Template ID
# Public Key: Account -> API Keys -> Public Key
# Private Key (opcional, recomendado para server-side): Account -> API Keys -> Private/REST key
EMAILJS_SERVICE_ID=tu-service-id
EMAILJS_TEMPLATE_ID=tu-template-id
EMAILJS_PUBLIC_KEY=tu-public-key
EMAILJS_PRIVATE_KEY=tu-private-key-opcional

# URL pública del sitio (para sitemap, canonical y metadatos)
NEXT_PUBLIC_SITE_URL=https://psicostephania.com